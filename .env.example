# Database
# Supports postgresql+psycopg://, postgresql://, postgres://, and sqlite+pysqlite:///
DATABASE_URL=postgresql+psycopg://hacknova:hacknova@localhost:5432/hacknova

# Auth & Security
# In production (APP_ENV=production), JWT_SECRET must be at least 32 characters and cannot be default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080

# Application Environment & CORS
# In production, CORS_ORIGINS cannot be empty and cannot contain wildcard '*'
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Provisioning (used by backend/scripts/create_admin.py)
ADMIN_EMAIL=admin@hacknova.dev
ADMIN_NAME=HackNova Organizer
ADMIN_PASSWORD=change-me-admin-password-12345

# Database Seeding Safety (used by backend/app/seed.py)
# In production, ALLOW_PRODUCTION_SEED must be true to allow seeding,
# and SEED_ADMIN_PASSWORD & SEED_STUDENT_PASSWORD are mandatory.
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_PASSWORD=change-me-seed-admin-12345
SEED_STUDENT_PASSWORD=change-me-seed-student-12345

# LLM Configuration
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
